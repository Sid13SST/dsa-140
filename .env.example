# ---------------------------------------------------------------------------
# Client-side (bundled into the browser build — safe to expose, but ONLY these)
# Leave both unset to run in local-only mode: no sign-in, no paywall, progress
# stored in this browser.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only (Vercel env vars — NEVER prefix these with VITE_, or they
# get bundled into the browser and anyone can unlock access for free).
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase → Project Settings → API → service_role. Bypasses RLS. Treat as a password.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Settings → API Keys. Use rzp_test_* keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
