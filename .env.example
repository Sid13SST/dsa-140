# Copy to .env.local (gitignored) and fill in. Restart the dev server after.

# Accounts. Off means the dashboard opens with no sign-in and progress is kept
# in localStorage. Turn it on once a Clerk key is set below.
VITE_AUTH_ENABLED=false

# Clerk publishable key, from the Clerk dashboard under API keys. PUBLIC by
# design — it identifies the instance and grants nothing on its own.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Paywall. Off means no payment step and no serverless functions needed.
VITE_PAYMENTS_ENABLED=false
VITE_RAZORPAY_KEY_ID=

# SERVER SECRETS — set these in your host's dashboard, never in this file, never
# with a VITE_ prefix, and never paste them into a chat. Only needed for the
# admin console and for payments.
# CLERK_SECRET_KEY=
# ADMIN_EMAILS=siddhant.prasad8@gmail.com
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# SERVER, NOT SECRET — the authentication policy in api/_lib/claims.mjs.
#
# CLERK_AUTHORIZED_PARTIES: comma-separated origins allowed to mint tokens for
# this API. Unset means that check cannot run and any origin on your Clerk
# instance is accepted; the functions log a warning while it is missing.
# CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app,http://localhost:5173
#
# CLERK_ISSUER: required once you move to a PRODUCTION Clerk instance, which
# issues from clerk.<your-domain>. Development instances (*.clerk.accounts.dev)
# are recognised without it. Set it wrong and every request 401s with
# `wrong_issuer` in the logs.
# CLERK_ISSUER=https://clerk.your-domain.com
