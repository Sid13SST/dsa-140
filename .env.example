# Copy to .env.local (gitignored) and fill in. Restart the dev server after.
#
# These two are PUBLIC by design — they are compiled into the browser bundle.
# The anon key grants nothing on its own; Row Level Security decides what it can
# reach, which is why supabase/schema.sql must be run before this is safe.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Paywall. Off means: sign in and you are straight into the dashboard, with no
# payment step and no serverless functions needed at all.
VITE_PAYMENTS_ENABLED=false

# Only needed when VITE_PAYMENTS_ENABLED=true. The bottom three are SERVER
# secrets — set them in Vercel's dashboard, never in this file, never with a
# VITE_ prefix, and never paste them into a chat.
VITE_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
